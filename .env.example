# MiMo Sentinel Audit — Environment Configuration
# Copy this file to .env and fill in your values

# RPC Endpoints
ETHEREUM_RPC=https://eth.llamarpc.com
BSC_RPC=https://bsc-dataseed.binance.org
POLYGON_RPC=https://polygon-rpc.com
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc

# Block Explorer API Keys (optional, for source code verification)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=

# MiMo AI API Key
MIMO_API_KEY=

# Scanner Settings
MAX_ITERATIONS=1000
SCAN_TIMEOUT=300
OUTPUT_FORMAT=html
OUTPUT_DIR=./reports

# Logging
LOG_LEVEL=INFO
LOG_FILE=
